{
  // Load paths for VsRocq; keep in sync with proof/_RocqProject.
  "vsrocq.args": [
    "-Q", "proof/model", "Model",
    "-Q", "proof/vst", "Vst",
    "-Q", "proof/ssprove", "Sec",
    "-Q", "proof/assumptions", "Assumptions",
    "-w", "-deprecated-from-Coq,-notation-overridden,-ambiguous-paths"
  ],
  "files.exclude": {
    "**/*.vo": true,
    "**/*.vok": true,
    "**/*.vos": true,
    "**/*.glob": true,
    "**/.*.aux": true,
    "**/.lia.cache": true,
    "**/.nia.cache": true,
    "**/Makefile.coq": true,
    "**/Makefile.coq.conf": true,
    "**/.Makefile.coq.d": true,
    "**/Makefile.rocq": true,
    "**/Makefile.rocq.conf": true,
    "**/.Makefile.rocq.conf.d": true,
    "**/rocq_mcp_cache_*_.v": true,
    "proof/assumptions/*.out": true
  }
}
