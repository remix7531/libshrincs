{
  // Load path for VsRocq: the objects Dune writes. Keep in step with proof/_RocqProject.
  "vsrocq.args": [
    "-Q", "_build/default/proof", "Shrincs",
    "-w", "-deprecated-from-Coq,-notation-overridden,-ambiguous-paths,-notation-incompatible-format"
  ],
  "files.exclude": {
    "**/*.vo": true,
    "**/*.vok": true,
    "**/*.vos": true,
    "**/*.glob": true,
    "**/.*.aux": true,
    "**/.lia.cache": true,
    "**/.nia.cache": true,
    "_build": true,
    "**/rocq_mcp_cache_*_.v": true
  }
}
