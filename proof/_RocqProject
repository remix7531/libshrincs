internal/ssprove/lib/chain/ud.v

# --- ssprove: WOTS+C scheme + one-time security proof ---
internal/ssprove/wots/params.v
internal/ssprove/wots/scheme.v
internal/ssprove/wots/games.v
internal/ssprove/wots/analysis.v
# shared hop substrate (intermediate games + pure pickers/bridges) so the
# hops below type-check in parallel instead of through a serial Require chain
internal/ssprove/wots/hop/intermediates.v
