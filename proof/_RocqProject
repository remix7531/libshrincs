-Q . Shrincs

# One logical root for the proof trees, standalone audit files and
# generated Clight ASTs. Each directory nests under Shrincs.

-arg -w -arg -deprecated-from-Coq,-notation-overridden,-ambiguous-paths,-notation-incompatible-format
# -deprecated-from-Coq exists SOLELY for the four clightgen-generated
# files (clight/*.v, `From Coq Require ...`); hand-written files
# must not need it -- the codebase is otherwise deprecation-clean.

# ONE AST PER .c FILE, in link order: nothing is -include'd into
# anything, so a function that crosses a translation-unit boundary is
# Internal in exactly one of these and External in the others. What
# reconciles the two is internal/vst/link.v, not the extraction.
clight/util.v
clight/sha256.v
clight/thash.v
clight/wots.v

# --- Public definitions ------------------------------------------------
sha256.v
spec.v
contracts.v
games.v

# --- SHA-256 proof tree -------------------------------------------------
# internal/common/bytes.v supplies word bounds. contracts.v provides the
# shared CompSpecs, reused by internal/vst/support/base.v and every body.
# internal/vst/sha256/clone.v carries derived facts, and sync.v pins the clone to
# the canonical definition. The body proofs follow call order. vsu.v
# assembles their component, and correct.v states its exported contract
# over sha256.v's spelling.

internal/common/bytes.v

internal/vst/support/base.v
internal/vst/support/settings.v
internal/vst/support/repr/seqlist.v
internal/vst/support/repr/words.v
internal/vst/support/repr/int32.v

internal/vst/sha256/clone.v
internal/vst/sha256/sync.v
internal/vst/sha256/bridge.v
internal/vst/sha256/tables.v
internal/vst/sha256/contract.v
internal/vst/sha256/verif/logical.v
internal/vst/sha256/verif/load_be32.v
internal/vst/sha256/verif/store_be32.v
internal/vst/sha256/verif/parse.v
internal/vst/sha256/verif/compress_words.v
internal/vst/sha256/verif/compress_blocks.v
internal/vst/sha256/verif/sha256.v
internal/vst/sha256/vsu.v
internal/vst/sha256/correct.v

# --- WOTS+C against spec.v ----------------------------------------------
# contracts.v (above) states the three entry points over spec.v.
# internal/vst/shape.v relates the loops of spec.v to the loops of the C,
# with no memory in it. Under internal/vst/support/: contract/helpers.v
# has the contracts of the static functions and the two shared units,
# theory/values.v the C values of words and bytes, contract/buffer.v the
# buffer the C fills from the left, contract/gprog.v one proof context
# per translation unit.
internal/vst/shape.v
internal/vst/support/contract/helpers.v
internal/vst/support/theory/values.v
internal/vst/support/contract/trusted.v
internal/vst/support/contract/buffer.v
internal/vst/support/contract/gprog.v

internal/vst/util/body_shrincs_memset.v
internal/vst/util/body_shrincs_memcpy.v
internal/vst/util/body_shrincs_panic.v
internal/vst/thash/body_shrincs_adrs_pack.v
internal/vst/thash/body_shrincs_thash.v
internal/vst/wots/body_shrincs_wots_c_t_sf.v
internal/vst/wots/body_shrincs_wots_c_f.v
internal/vst/wots/body_shrincs_wots_c_h_grind.v
internal/vst/wots/body_shrincs_wots_c_prf.v
