# and builds its objects under _build/default/proof. Build @proof/prove
# from the repository root before opening proof files in an editor.

-Q ../_build/default/proof Shrincs

-arg -w -arg -deprecated-from-Coq,-notation-overridden,-ambiguous-paths,-notation-incompatible-format
