(include_subdirs qualified)

; One clightgen run per C file, and no -include anywhere: the four C sources
; are four translation units, each verified as its own component and joined in
; internal/vst/link.v. The programs land in clight/ so that the theory below
; sees them as Shrincs.clight.*. Each rule depends on every header, so a new
; #include can never leave a stale program behind.
(subdir
 clight
 (rule
  (target util.v)
  (deps ../../src/util.c (glob_files ../../include/*.h) (glob_files ../../src/*.h))
  (action
   (run clightgen -normalize -I../../src -I../../include -Wp,-w -o %{target} ../../src/util.c)))
 (rule
  (target sha256.v)
  (deps ../../src/sha256.c (glob_files ../../include/*.h) (glob_files ../../src/*.h))
  (action
   (run clightgen -normalize -I../../src -I../../include -Wp,-w -o %{target} ../../src/sha256.c)))
 (rule
  (target thash.v)
  (deps ../../src/thash.c (glob_files ../../include/*.h) (glob_files ../../src/*.h))
  (action
   (run clightgen -normalize -I../../src -I../../include -Wp,-w -o %{target} ../../src/thash.c)))
 (rule
  (target wots.v)
  (deps ../../src/wots.c (glob_files ../../include/*.h) (glob_files ../../src/*.h))
  (action
   (run clightgen -normalize -I../../src -I../../include -Wp,-w -o %{target} ../../src/wots.c))))

(rocq.theory
 (name Shrincs)
 (modules :standard \ audit.probe audit.statement audit.guards)
 (theories
  Stdlib
  Ltac2
  VST
  compcert
  Flocq
  MenhirLib
  mathcomp.boot
  mathcomp.order
  mathcomp.algebra
  mathcomp.ssreflect
