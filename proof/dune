  Equations)
 (flags :standard -w -deprecated-from-Coq,-notation-overridden,-ambiguous-paths,-notation-incompatible-format)
 (mode vo))

(alias
 (name prove)
 (deps (glob_files_rec *.vo)))

; A bare `dune build` builds the C library and nothing here: the proofs take
; tens of minutes and are asked for by name.
(alias
 (name default)
 (deps))

; What git tracks under proof/. The audit refuses a source that is compiled
; into the theory without being tracked. Git's index is not a file Dune can
; watch, so the list is rewritten on every build. Dune hides the repository
; from sandboxed actions, so git is pointed at it through INSIDE_DUNE, the
; absolute path of the build context, which sits two levels below the root.
(rule
 (target tracked-sources.txt)
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (system "git -C \"$INSIDE_DUNE/../..\" ls-files -- 'proof/*.v'"))))

; The honesty gate, run in a sandbox that holds every source the theory
; compiled, every object, and the audit's own files. The report is the trust
; surface table. Query outputs must stay out of the input set, because Dune
; materializes dependencies as read-only files.
(rule
 (alias audit)
 (target audit-report.txt)
 (deps
  (sandbox always)
  tracked-sources.txt
  (glob_files_rec *.vo)
  (glob_files_rec *.v)
  audit/check.sh
  audit/statement.sh
  audit/declarations.awk
  audit/guard_inventory.py
  audit/guard_inventory.v.in
  audit/allowed.txt)
 (action
  (with-stdout-to
   %{target}
   (run bash audit/check.sh tracked-sources.txt))))

(rule
 (aliases audit-test runtest)
 (deps
  (sandbox always)
  audit/test.sh
  audit/check.sh
  audit/statement.sh
  audit/declarations.awk
  audit/guard_inventory.py
  audit/guard_inventory.v.in
  audit/statement.v)
 (action
  (run bash audit/test.sh)))
